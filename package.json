{
  "name": "plainly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run src",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "check": "biome check . && pnpm typecheck && pnpm test && pnpm arch",
    "eval": "vitest run evals",
    "e2e": "playwright test",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/shared/lib/db-types.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.99",
    "@ai-sdk/react": "^4.0.170",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "ai": "^7.0.166",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "next-intl": "^4.14.10",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.7.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19"
  }
}
