{
  "name": "plainly",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @plainly/web dev",
    "build": "pnpm --filter @plainly/web build",
    "start": "pnpm --filter @plainly/web start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --filter @plainly/web typecheck",
    "test": "pnpm --filter @plainly/web test",
    "arch": "pnpm --filter @plainly/web arch",
    "check": "biome check . && pnpm --filter @plainly/web check",
    "eval": "pnpm --filter @plainly/web eval",
    "e2e": "pnpm --filter @plainly/web e2e",
    "db:test": "DO_NOT_TRACK=1 supabase test db",
    "test:db": "DO_NOT_TRACK=1 supabase test db",
    "db:types": "supabase gen types typescript --local > apps/web/src/shared/lib/db-types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.65.0"
  }
}
