# Copy to .env.local. Values below match `supabase start` on this repo's ports.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54325
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Used by the expiry cron to delete storage files.
SUPABASE_SECRET_KEY=sb_secret_xxx

# AI. Leave ANTHROPIC_API_KEY empty and set USE_FAKE_AI=true to work offline for free.
ANTHROPIC_API_KEY=
AI_MODEL_ANALYSIS=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
USE_FAKE_AI=true

# Protects /api/cron/expire (Vercel Cron sends it as a Bearer token).
CRON_SECRET=change-me-to-a-long-random-string
