# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: keep the example
!.env.example

# test output
playwright-report/
test-results/
blob-report/

# real documents used for local testing (never committed; scripts/check-files.mjs also guards this)
private-docs/
local-test-docs/

# third-party reference images (mood board, no redistribution license): kept locally only
assets/images-mockup/

# Supabase Studio saved queries (local only)
supabase/snippets/

# local tool settings
.claude/settings.local.json
*.local

# personal notes (never committed)
z.md
z-*.md

# eval output (timestamped)
apps/web/evals/results-*.json

# Screenshot PNG masters (webp copies are committed)
assets/media/screenshots/raw/
assets/media/out/
assets/media/walkthrough/raw/
