{
  "name": "@plainly/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run src",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm test && pnpm arch",
    "eval": "vitest run evals",
    "e2e": "playwright test",
    "ai:try": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/ai-try.ts",
    "ai:eval": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/ai-eval.ts",
    "ai:report": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/ai-report.ts",
    "ai:samples": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/ai-samples.ts",
    "test:int": "vitest run --config vitest.int.config.mts",
    "test-user": "tsx scripts/test-user.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.106",
    "@ai-sdk/google": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.93",
    "@ai-sdk/react": "^4.0.181",
    "@ai-sdk/xai": "^5.0.47",
    "@sentry/nextjs": "^11.15.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "ai": "^7.0.177",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "docx-preview": "0.4.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-intl": "^4.15.3",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
