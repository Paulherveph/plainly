# Copy to .env.local. Values below match `supabase start` on this repo's ports.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54325
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Retention job, guest merge, account deletion, feature flags, alerts.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- AI providers (set only the ones you use; API keys, not chat subscriptions) ---
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio key), e.g. AI_MODEL=google:gemini-3.8-flash
GEMINI_API_KEY=
# Grok (xAI console key), e.g. AI_MODEL=xai:grok-4.7
XAI_API_KEY=
# Optional allow-list (e.g. anthropic,ollama). Empty = the providers your profiles use.
AI_PROVIDERS_ALLOWED=

# Ollama: local by default (no key). Ollama Cloud: OLLAMA_BASE_URL=https://ollama.com/v1 plus OLLAMA_API_KEY.
# Local setup in 3 lines: USE_FAKE_AI=false, AI_MODEL=ollama:<installed model>, AI_TIMEOUT_MS=600000.
# See docs/AI_PROVIDERS.md "Ollama (local or cloud)".
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# One model for every profile (e.g. ollama:llama3.2:3b). Unset AI_PROFILE_* lines fall back to it, and an
# unset AI_PROVIDERS_ALLOWED becomes the providers the profiles use.
AI_MODEL=

# Model profiles: comma-separated "provider:model" in fallback order. Each model needs a row in
# src/modules/ai/domain/pricing.ts (Ollama needs none). Uncomment to override AI_MODEL per profile.
# Without AI_MODEL or these lines, the defaults are the Claude models shown. Production refuses models without a passing `pnpm ai:eval`
# unless AI_ALLOW_UNVERIFIED_MODELS=true.
# AI_PROFILE_ANALYSIS=anthropic:claude-sonnet-5-5
# AI_PROFILE_CHAT=anthropic:claude-haiku-5-5,anthropic:claude-sonnet-5-5
# AI_PROFILE_CHAT_DEEP=anthropic:claude-sonnet-5-5
# AI_PROFILE_FAST=anthropic:claude-haiku-5-5
# AI_PROFILE_TRANSLATE=anthropic:claude-haiku-5-5

# Safety rails
AI_DAILY_BUDGET_USD=5
# Optional. Overrides the per-profile timeouts (ms). Raise it for slow local models, e.g. 600000.
AI_TIMEOUT_MS=
AI_ALLOW_UNVERIFIED_MODELS=false
# true = deterministic fake AI (0 tokens). Use for local work, E2E and load tests.
USE_FAKE_AI=true

# --- Email (Resend). Budget alerts, account deletion confirmation. ---
RESEND_API_KEY=
EMAIL_FROM=Plainly <hello@example.com>
ALERT_EMAIL=

# --- Bot protection (Cloudflare Turnstile). Empty = captcha skipped (local only). ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs the short-lived guest-merge cookie (32+ random characters).
GUEST_MERGE_SECRET=change-me-to-a-32-character-random-string

# --- Billing ("fake" until a live provider is chosen in S5) ---
BILLING_PROVIDER=fake
BILLING_WEBHOOK_SECRET=change-me-16-chars-min

# --- Error tracking (optional) ---
SENTRY_DSN=

# Protects /api/cron/expire (Vercel Cron sends it as a Bearer token).
CRON_SECRET=change-me-to-a-long-random-string

# --- Public extras ---
# Sentry for the browser (optional; same project as SENTRY_DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Who operates Plainly (company or sole proprietor), shown in the footer and the Terms. Required before charging.
NEXT_PUBLIC_OPERATOR=
# E2E only: lets the fake-billing simulator run under `next start`. Never set in production.
ALLOW_FAKE_BILLING=false
